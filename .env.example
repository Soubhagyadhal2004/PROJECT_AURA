# Copy this file to .env and paste your key from https://aistudio.google.com/apikey
# The key is only read by the local AURA server; it is never sent to the browser.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite          # memory extraction (500 requests/day on the free tier)
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite    # meeting transcription when Live transcription is off
# AURA_PORT=3001
# AURA_DATA_DIR=./data

# Proactive nudges: all OFF unless set to 1 (see README, "Proactive nudges")
# AURA_PROACTIVE_MEMORY=1        # "Is this still true?" for older facts that change
# AURA_PROACTIVE_REMINDERS=1     # "remind me ..." and dated meeting action items (asks before setting)
# AURA_PROACTIVE_BRIEFING=1      # "Brief me" button; add AURA_BRIEFING_TIME=08:30 for a daily one
# AURA_NUDGE_MAX_PER_DAY=3
# AURA_NUDGE_COOLDOWN_MIN=120
# AURA_QUIET_HOURS=22:00-08:00
# AURA_MEMORY_CHECKS_PER_DAY=1
# AURA_MEMORY_CHECK_AFTER_DAYS=30
# AURA_TIMEZONE=Asia/Kolkata

# Ambient mode (the ear button): AURA speaks on its own only when the need keeps rising past the threshold
# AURA_AMBIENT_THRESHOLD=0.6     # smoothed need (0..1) needed before AURA chips in
# AURA_AMBIENT_WINDOW=3          # utterances in the slope fit
# AURA_AMBIENT_MIN_POINTS=3      # utterances heard before AURA may speak on its own
# AURA_AMBIENT_FLAT=0.04         # |slope| per utterance below this counts as flat (defer)
# AURA_AMBIENT_SMOOTHING=0.6     # weight of the newest score in the moving average
# AURA_AMBIENT_COOLDOWN_SEC=60   # quiet time after AURA spoke (same topic only)
# AURA_AMBIENT_PERSIST=3        # high but flat for this many turns -> speak once anyway (0 = never)
# AURA_AMBIENT_FOLLOWUP_SEC=25   # a reply right after AURA spoke is answered without its name
# AURA_AMBIENT_STALE_SEC=180     # a pause this long starts a new trend
# AURA_AMBIENT_VOICE_GATE=auto   # only registered voices are heard: auto (on once a voice profile exists) | on | off
# AURA_AMBIENT_GATE_THRESHOLD=0.5  # similarity to a voice profile needed to pass
# AURA_AMBIENT_GATE_MIN_SEC=1.0  # shorter clips pass only when they are said to AURA
# AURA_AMBIENT_GATE_ONLY=        # accept just one registered person, e.g. Soubhagya
# AURA_AMBIENT_FEEDBACK_DAYS=30  # how long "not now" / "thanks" after an unprompted remark moves the threshold

# Agent tasks (server/agent.mjs): multi-step requests, with approval for consequential steps
# AURA_AGENT_SUMMARY=model       # also ask Gemini for a task summary (off by default: +4-5 s per task, the voice model words it itself)
# AURA_AGENT_COMPARE_TIMEOUT_MS=4000  # a slow "does this new fact conflict?" check is cut off after this long and asks you instead
# AURA_AGENT_AUTO_WRITE=1        # 0 = also ask before reversible writes (new memory, reminder suggestion)
# AURA_MEMORY_STALE_DAYS=180     # work/people/plan facts not confirmed for this long are flagged "may be outdated"
