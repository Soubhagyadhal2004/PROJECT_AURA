# Copy this file to .env and paste your key from https://aistudio.google.com/apikey
# The key is only read by the local AURA server; it is never sent to the browser.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_TEXT_MODEL=gemini-flash-latest            # memory extraction
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-lite-latest # meeting transcription
# AURA_PORT=3001
# AURA_DATA_DIR=./data
