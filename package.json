{
  "name": "aura",
  "version": "1.0.0",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@huggingface/transformers": "^4.3.1",
    "classnames": "^2.5.1",
    
    "eventemitter3": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "sass": "^1.80.6",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:server\" \"npm:start\"",
    "server": "node server/index.mjs",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "serve": "node server/index.mjs",
    "test": "react-scripts test",
    "test:server": "node --experimental-test-module-mocks --no-warnings --test server/tests/pipeline.test.mjs server/tests/turns.test.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.119",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "typescript": "^5.6.3"
  },
  "private": true,
  "proxy": "http://127.0.0.1:3001",
  "engines": {
    "node": ">=22.13"
  }
}
